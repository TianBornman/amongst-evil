<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Style%20Sheets/Settings%20UI.uss?fileID=7433441132597879392&amp;guid=9027e898f4d048b4dafb22d4d2b04921&amp;type=3#Settings UI" />
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 40%; height: 80%; max-height: 80%; margin-top: auto; margin-right: auto; margin-bottom: auto; margin-left: auto; background-image: url(&quot;project://database/Assets/Icons/Background%20Light.png?fileID=21300000&amp;guid=abb3a90770fe1ef4e926a5082d9cf099&amp;type=3#Background Light&quot;); -unity-slice-left: 10; -unity-slice-top: 10; -unity-slice-right: 10; -unity-slice-bottom: 10; -unity-font-definition: url(&quot;project://database/Assets/Fonts/MedodicaRegular.otf?fileID=12800000&amp;guid=a8d6cacb785c6b34a988a195851fb3cb&amp;type=3#MedodicaRegular&quot;);">
        <ui:Label text="Settings" name="Label" style="font-size: 36px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-style: bold;" />
        <ui:VisualElement name="Items" style="flex-grow: 1; margin-top: 0; margin-right: 15px; margin-bottom: 15px; margin-left: 15px; background-image: url(&quot;project://database/Assets/Icons/Background%20Dark.png?fileID=2800000&amp;guid=e6c22da5f9621004c928063bb50ababb&amp;type=3#Background Dark&quot;); -unity-slice-left: 10; -unity-slice-top: 10; -unity-slice-right: 10; -unity-slice-bottom: 10; color: rgb(255, 255, 255); font-size: 30px; padding-top: 15px; padding-right: 15px; padding-bottom: 15px; padding-left: 15px;">
            <ui:VisualElement name="Item" style="flex-grow: 0;">
                <ui:Slider label="Music:" value="0.5" high-value="1" fill="true" name="Music">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="musicSource.volume" data-source-type="AudioManager, Assembly-CSharp" binding-mode="TwoWay" />
                    </Bindings>
                </ui:Slider>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
