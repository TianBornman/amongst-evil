:root {
    background-image: url("project://database/Assets/Icons/Background%20Dark.png?fileID=2800000&guid=e6c22da5f9621004c928063bb50ababb&type=3#Background Dark");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-font-definition: url("project://database/Assets/Fonts/MedodicaRegular.otf?fileID=12800000&guid=a8d6cacb785c6b34a988a195851fb3cb&type=3#MedodicaRegular");
}

.equip-slot {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    background-image: url("project://database/Assets/Icons/Background%20Light.png?fileID=2800000&guid=abb3a90770fe1ef4e926a5082d9cf099&type=3#Background Light");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
}

.equip-slot VisualElement {
    flex-basis: 0;
    flex-grow: 3;
    -unity-background-scale-mode: scale-to-fit;
}

.equip-slot Label {
    flex-basis: 0;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

#Bars ProgressBar {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 255, 255);
}

#Bars ProgressBar .unity-progress-bar__background {
    background-color: rgb(41, 41, 41);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
}

#Bars ProgressBar .unity-progress-bar__progress {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

#Bars #HealthBar {
    margin-bottom: 5px;
}

#Bars #HealthBar .unity-progress-bar__progress {
    background-color: rgb(140, 28, 41);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

#Bars #XpBar .unity-progress-bar__background {
    max-height: 15px;
}

#Bars #XpBar .unity-progress-bar__progress {
    background-color: rgb(190, 168, 58);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.stat-entry {
    flex-direction: row;
    flex-grow: 0;
}

.stat-entry .stat-field {
    color: rgb(255, 255, 255);
    margin-left: auto;
    margin-right: auto;
    margin-top: 10px;
    width: 50%;
    -unity-text-align: upper-center;
    flex-direction: row;
}

.tab-bar {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 5px;
}

.tab-button {
    flex-grow: 1;
    flex-basis: 0;
    padding-top: 6px;
    padding-right: 10px;
    padding-bottom: 6px;
    padding-left: 10px;
    margin-right: 4px;
    background-color: rgba(20, 20, 20, 0.6);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.tab-button:hover {
    background-color: rgba(60, 60, 60, 0.8);
}

.tab-button Label {
    color: rgb(180, 180, 180);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.tab-button--active {
    background-color: rgba(140, 28, 41, 0.85);
}

.tab-button--active Label {
    color: rgb(255, 255, 255);
}

.stats-header {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 8px;
    margin-left: 5px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    background-image: url("project://database/Assets/Icons/Background%20Light.png?fileID=2800000&guid=abb3a90770fe1ef4e926a5082d9cf099&type=3#Background Light");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
}

.stats-header__name {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    font-size: 18px;
    margin-bottom: 4px;
}

.stats-header__row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 4px;
}

.stats-header__label {
    color: rgb(200, 200, 200);
    -unity-font-style: bold;
    margin-right: 6px;
}

.stats-header__value {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.stats-header__xpbar {
    height: 12px;
    margin-top: 4px;
    color: rgb(255, 255, 255);
}

.stats-header__xpbar .unity-progress-bar__background {
    background-color: rgb(41, 41, 41);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    max-height: 12px;
}

.stats-header__xpbar .unity-progress-bar__progress {
    background-color: rgb(190, 168, 58);
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.stats-columns {
    flex-direction: row;
    margin-top: 4px;
    margin-right: 8px;
    margin-bottom: 2px;
    margin-left: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.2);
    padding-bottom: 2px;
}

.stats-columns__heading {
    color: rgb(180, 180, 180);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.stat-section {
    color: rgb(190, 168, 58);
    -unity-font-style: bold;
    margin-top: 8px;
    margin-right: 8px;
    margin-bottom: 2px;
    margin-left: 8px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.stat-row {
    flex-direction: row;
    flex-grow: 0;
    margin-top: 1px;
    margin-right: 8px;
    margin-bottom: 1px;
    margin-left: 8px;
    padding-top: 2px;
    padding-right: 4px;
    padding-bottom: 2px;
    padding-left: 4px;
}

.stat-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.stat-row__label {
    color: rgb(220, 220, 220);
    flex-grow: 2;
    flex-basis: 0;
    -unity-text-align: middle-left;
}

.stat-row__base {
    color: rgb(180, 180, 180);
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-center;
}

.stat-row__delta {
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.stat-row__total {
    color: rgb(255, 255, 255);
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.stat-row__delta--positive {
    color: rgb(110, 220, 120);
}

.stat-row__delta--negative {
    color: rgb(230, 110, 110);
}

.stat-row__delta--neutral {
    color: rgba(255, 255, 255, 0.35);
}
