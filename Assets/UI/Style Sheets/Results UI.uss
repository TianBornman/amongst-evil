.results-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.7);
    max-height: 80%;
    width: 70%;
    margin: auto;
    border-radius: 15px;
    padding: 20px;
    flex-direction: column;
}

.results-title {
    font-size: 36px;
    -unity-text-align: upper-center;
    color: rgb(255, 255, 255);
    margin-bottom: 15px;
}

.results-columns {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
}

.result-column {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 6px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.total-column {
    background-color: rgba(180, 140, 60, 0.18);
    border-color: rgba(220, 180, 90, 0.5);
}

.column-name {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.column-status {
    font-size: 14px;
    -unity-text-align: middle-center;
    color: rgb(180, 180, 180);
    margin-bottom: 8px;
}

.column-status.alive {
    color: rgb(120, 220, 120);
}

.column-status.dead {
    color: rgb(220, 90, 90);
}

.stat-row {
    flex-direction: row;
    max-height: 28px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.stat-row .stat-label {
    flex-basis: 0;
    flex-grow: 1;
    color: rgb(200, 200, 200);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.stat-row .stat-value {
    flex-basis: 0;
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.hidden {
    display: none;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
}

.results-button {
    margin: 5px 10px;
    width: 18%;
    border-radius: 10px;
    padding: 6px;
}

.results-button-wide {
    width: 30%;
}

.results-page {
    flex-grow: 1;
    flex-direction: column;
}

.aftermath-flavor {
    font-size: 16px;
    color: rgb(220, 200, 160);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    margin-bottom: 10px;
    white-space: normal;
}

.aftermath-flavor-small {
    font-size: 13px;
    color: rgb(180, 170, 150);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    margin-top: 6px;
    margin-bottom: 4px;
    white-space: normal;
}

.aftermath-body {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
}

.aftermath-section {
    flex-basis: 0;
    flex-grow: 1;
    margin: 6px;
    padding: 14px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.aftermath-section-title {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.standing-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 8px;
}

.standing-value {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 0 8px;
}

.standing-arrow {
    font-size: 22px;
    color: rgb(180, 180, 180);
    margin: 0 6px;
}

.standing-delta {
    font-size: 18px;
    -unity-font-style: bold;
    margin-left: 10px;
}

.standing-delta.gain {
    color: rgb(120, 220, 120);
}

.standing-delta.loss {
    color: rgb(220, 90, 90);
}

.rank-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.aftermath-key {
    color: rgb(200, 200, 200);
    font-size: 14px;
    margin-right: 6px;
}

.aftermath-val {
    color: rgb(255, 235, 180);
    font-size: 14px;
    -unity-font-style: bold;
}

.ascension-banner {
    margin-top: 10px;
    padding: 8px;
    -unity-text-align: middle-center;
    color: rgb(255, 215, 120);
    font-size: 15px;
    -unity-font-style: bold;
    background-color: rgba(180, 140, 60, 0.18);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(220, 180, 90, 0.5);
    white-space: normal;
}

.vault-list {
    flex-direction: column;
    margin-top: 4px;
}

.vault-entry {
    -unity-text-align: middle-center;
    font-size: 14px;
    margin: 1px 0;
    color: rgb(220, 220, 220);
}

.vault-entry.fallen {
    color: rgb(220, 130, 130);
}

.vault-entry.survivor {
    color: rgb(150, 220, 150);
}
