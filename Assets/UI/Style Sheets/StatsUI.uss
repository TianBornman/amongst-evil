.stat-entry {
    flex-direction: row;
    flex-grow: 0;
}

.stat-entry .stat-field {
    color: rgb(255, 255, 255);
    margin-left: auto;
    margin-right: auto;
    margin-top: 10px;
    width: 50%;
    -unity-text-align: upper-center;
    flex-direction: row;
}

.hidden {
}

.inventory-pane {
    background-color: rgb(63, 63, 63);
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    flex-grow: 1;
    flex-basis: 0;
}

.item-slot {
    background-color: rgba(31, 31, 31, 0.69);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-top: auto;
    margin-right: 10px;
    margin-bottom: auto;
    margin-left: 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-grow: 1;
    flex-basis: 0;
}

.item-slot VisualElement {
    -unity-background-scale-mode: scale-to-fit;
    flex-basis: 0;
    flex-grow: 3;
}

.item-slot Label {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: auto;
    margin-right: 0;
    margin-bottom: auto;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-basis: 0;
    flex-grow: 1;
}

.equip-slot {
    background-color: rgba(31, 31, 31, 0.69);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 5px;
    margin-left: 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-grow: 1;
    flex-basis: 0;
}

.equip-slot VisualElement {
    -unity-background-scale-mode: scale-to-fit;
    flex-basis: 0;
    flex-grow: 3;
}

.equip-slot Label {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: auto;
    margin-right: 0;
    margin-bottom: auto;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-basis: 0;
    flex-grow: 1;
}

.slot-segment {
    flex-direction: column;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-basis: 0;
    flex-grow: 1;
    align-items: stretch;
}

.character-panel {
    flex-direction: column;
}

.selected {
    background-color: rgb(26, 26, 26);
}

.character-stats {
    flex-basis: 0;
    flex-grow: 1;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    background-color: rgb(41, 41, 41);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.hidden {
    display: none;
}

.character-panel > #Slots {
    flex-direction: row;
}

.character-panel > #Bars {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.character-panel > #Bars #HealthBar {
    margin-bottom: 5px;
}

.character-panel > #Bars ProgressBar {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 255, 255);
}

.character-panel > #Bars ProgressBar .unity-progress-bar__background {
    background-color: rgb(41, 41, 41);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
}

.character-panel > #Bars ProgressBar .unity-progress-bar__progress {
    background-color: rgb(63, 63, 63);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.character-panel > #Bars #XpBar .unity-progress-bar__background {
    max-height: 15px;
}

.character-panel > #Bars #HealthBar .unity-progress-bar__progress {
    background-color: rgb(140, 28, 41);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.character-panel > #Bars #XpBar .unity-progress-bar__progress {
    background-color: rgb(190, 168, 58);
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}
