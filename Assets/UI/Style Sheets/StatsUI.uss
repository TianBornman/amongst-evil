.inventory-pane {
    background-color: rgb(63, 63, 63);
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    flex-grow: 1;
    flex-basis: 0;
}

.item-slot {
    background-color: rgba(31, 31, 31, 0.69);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-top: auto;
    margin-right: 10px;
    margin-bottom: auto;
    margin-left: 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-grow: 1;
    flex-basis: 0;
}

.item-slot VisualElement {
    -unity-background-scale-mode: scale-to-fit;
    flex-basis: 0;
    flex-grow: 3;
}

.item-slot Label {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: auto;
    margin-right: 0;
    margin-bottom: auto;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-basis: 0;
    flex-grow: 1;
}

#CharacterPanels > TemplateContainer {
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 0;
    margin-bottom: 0;
    margin-top: 0;
    margin-left: 0;
}
