.mission-board-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.mission-board-panel {
    width: 80%;
    height: 80%;
    padding: 24px;
    background-color: rgb(35, 35, 40);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-color: rgb(80, 65, 50);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    align-items: stretch;
}

.mission-board-title {
    font-size: 36px;
    color: rgb(235, 220, 195);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.mission-list {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-around;
    align-items: stretch;
}

.mission-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 8px;
    margin-right: 8px;
    padding: 16px;
    background-color: rgb(55, 50, 50);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-color: rgb(95, 75, 60);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.mission-card:hover {
    background-color: rgb(75, 65, 60);
    scale: 1.02 1.02;
    cursor: link;
}

.mission-card__title {
    font-size: 24px;
    color: rgb(235, 220, 195);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 6px;
}

.mission-card__type {
    font-size: 16px;
    color: rgb(180, 200, 220);
    -unity-font-style: italic;
    margin-bottom: 2px;
}

.mission-card__threat {
    font-size: 18px;
    color: rgb(220, 140, 110);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.mission-card__flavor {
    font-size: 14px;
    color: rgb(200, 195, 185);
    white-space: normal;
    flex-grow: 1;
}

.mission-board-cancel {
    align-self: center;
    margin-top: 18px;
    padding: 8px 24px;
    font-size: 18px;
    color: rgb(235, 220, 195);
    background-color: rgb(70, 55, 50);
    border-color: rgb(95, 75, 60);
}

.mission-board-cancel:hover {
    background-color: rgb(95, 70, 60);
}
