    <ui:VisualElement name="Inventory" style="background-color: rgb(99, 99, 99); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; width: 90%; height: 80%; margin-top: auto; margin-right: auto; margin-bottom: auto; margin-left: auto;">
