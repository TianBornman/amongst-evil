                <ui:VisualElement name="Level" class="stat-entry">
                    <ui:Label text="Level:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.level" data-source-type="PartyCharacter, Assembly-CSharp" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="Xp" class="stat-entry">
                    <ui:Label text="XP:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-type="PartyCharacter, Assembly-CSharp" binding-mode="ToTarget" data-source-path="currentXp" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="Health" class="stat-entry">
                    <ui:Label text="Health:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="Current and Total HP" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="BlockChance" class="stat-entry">
                    <ui:Label text="Block Chance:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.blockChance" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="Float to Percentage" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="DodgeChance" class="stat-entry">
                    <ui:Label text="Dodge Chance:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.dodgeChance" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="Float to Percentage" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="Damage" class="stat-entry">
                    <ui:Label text="Damage:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.damage" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="AttackSpeed" class="stat-entry">
                    <ui:Label text="Attack Speed:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.attackSpeed" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="Float to Attack Speed" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="CritChance" class="stat-entry">
                    <ui:Label text="Critical Chance:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.critChance" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="Float to Percentage" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="CritDamage" class="stat-entry">
                    <ui:Label text="Critical Damage:" class="stat-field" />
                    <ui:Label text="Label" class="stat-field">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="stats.critDamage" data-source-type="Character, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="Float to Percentage" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="HideStats" style="flex-grow: 1; background-color: rgb(63, 63, 63); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; position: absolute; right: 5px; top: 5px; font-size: 14px; width: 30px; height: 30px;">
                    <ui:Label text="X" style="color: rgb(255, 255, 255); -unity-text-align: middle-center; margin-top: auto; margin-right: auto; margin-bottom: auto; margin-left: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Items" class="inventory-pane" style="flex-grow: 1; flex-direction: row; margin-top: 5px; margin-bottom: 5px; padding-top: 5px; padding-left: 5px;">
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
            <Midevil.UI.Elements.ItemElement />
        </ui:VisualElement>
        <ui:VisualElement name="Relics" class="inventory-pane" style="flex-grow: 1; margin-top: 5px; flex-direction: row;" />
    </ui:VisualElement>
</ui:UXML>
