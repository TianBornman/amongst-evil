.healthbar {
    margin-top: auto;
    margin-right: auto;
    margin-bottom: auto;
    margin-left: auto;
    flex-basis: 0;
    flex-grow: 1;
}

.healthbar .unity-progress-bar__progress {
    background-color: rgb(154, 0, 0);
}

.xpbar .unity-progress-bar__progress {
    background-color: rgb(230, 238, 0);
}

.xpbar .unity-progress-bar__container {
    min-height: 100%;
}

.ability-slot {
    background-color: rgba(0, 0, 0, 0.57);
    flex-basis: 0;
    flex-grow: 1;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-right: 10px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.ability-slot VisualElement {
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-slot #charges {
    position: absolute;
    color: rgb(255, 255, 255);
    bottom: 5px;
    right: 5px;
}

.ability-slot #cooldown {
    position: absolute;
    color: rgb(255, 255, 255);
    bottom: auto;
    right: 5px;
    top: 5px;
}

.effect {
    background-color: rgba(0, 0, 0, 0.57);
    width: 30px;
    height: 30px;
    margin-top: auto;
    margin-bottom: 7px;
    margin-left: 7px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
}

.effect VisualElement {
    -unity-background-scale-mode: scale-to-fit;
    height: 100%;
    width: 100%;
}

.effect Label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 10px;
    bottom: 1px;
    right: 1px;
}
